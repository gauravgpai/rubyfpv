diff --git a/include/cv610_modes.h b/include/cv610_modes.h
index e05f6ff..4e82984 100644
--- a/include/cv610_modes.h
+++ b/include/cv610_modes.h
@@ -24,6 +24,30 @@ typedef struct {
 	const char *desc;          /* /api/v1/modes label */
 } Cv610SensorMode;
 
+/* One sensor the CV610 graph can drive.  Everything sensor-specific that the
+ * MPP API will not report lives here: which plugin to dlopen, the ISP bind
+ * id, the board's MIPI lane wiring, and the plugin's mode table.
+ *
+ * Selected once per process from the CV610_SENSOR environment variable
+ * (S95waybeam exports it from /etc/waybeam-cv610.conf); unset or unknown
+ * means imx662, the reference board. */
+typedef struct {
+	const char *name;          /* CV610_SENSOR value */
+	const char *lib_path;      /* sensor plugin */
+	const char *obj_symbol;    /* ot_isp_sns_obj exported by the plugin */
+	int sns_id;                /* ot_isp_bind_attr.sns_id, the plugin's *_ID */
+	short lane_id[4];          /* combo_dev_attr lane_id, -1 = unused */
+	int bayer;                 /* ot_isp_bayer_format */
+	const Cv610SensorMode *modes;
+	size_t mode_count;
+} Cv610Sensor;
+
+/* The active sensor.  Never NULL. */
+const Cv610Sensor *cv610_sensor(void);
+
+/* Number of MIPI data lanes the sensor is wired with. */
+int cv610_sensor_lane_count(const Cv610Sensor *sensor);
+
 /* The mode table, in advertised (index) order.  Never NULL. */
 const Cv610SensorMode *cv610_mode_table(size_t *count);
 
diff --git a/init.d/S95waybeam.cv610 b/init.d/S95waybeam.cv610
index 079cc1a..691f7ae 100755
--- a/init.d/S95waybeam.cv610
+++ b/init.d/S95waybeam.cv610
@@ -20,6 +20,12 @@ WAYBEAM_ENABLED=1
 # 30/60/90).  It names a clock profile, not the sensor -- that is an IMX662.
 CV610_SENSOR_PROFILE=sc4336p
 CV610_AUDIO=0
+# Sensor the daemon drives (imx662 or imx335); see src/cv610_modes.c.
+CV610_SENSOR=imx662
+# "loader" brings the MPP modules up with load-cv610-online.  "firmware"
+# trusts the set the OpenIPC firmware already loaded at boot (load_hisilicon,
+# vendor open_pm) and skips the loader, which refuses vendor open_pm.
+CV610_MODULES=loader
 # The platform override is target-local by design.
 # shellcheck disable=SC1090
 [ -r "$PLATFORM_CONFIG" ] && . "$PLATFORM_CONFIG"
@@ -45,8 +51,17 @@ start()
 	if [ -r "$PIDFILE" ]; then
 		rm -f "$PIDFILE"
 	fi
-	CV610_SENSOR_PROFILE="$CV610_SENSOR_PROFILE" \
-		CV610_AUDIO="$CV610_AUDIO" "$LOADER" start || return 1
+	if [ "$CV610_MODULES" = "firmware" ]; then
+		grep -q "^open_vi " /proc/modules &&
+			grep -q "^open_venc " /proc/modules || {
+			echo "CV610_MODULES=firmware but the MPP modules are not loaded" >&2
+			return 1
+		}
+	else
+		CV610_SENSOR_PROFILE="$CV610_SENSOR_PROFILE" \
+			CV610_AUDIO="$CV610_AUDIO" "$LOADER" start || return 1
+	fi
+	export CV610_SENSOR
 	: >"$LOGFILE"
 	start-stop-daemon -S -m -q -p "$PIDFILE" -x "$DAEMON" -- \
 		>>"$LOGFILE" 2>&1 &
@@ -65,7 +80,7 @@ start()
 		# nothing; the next start re-inits against them.
 		return 1
 	fi
-	echo "Started $NAME (sensor profile $CV610_SENSOR_PROFILE, audio $CV610_AUDIO)"
+	echo "Started $NAME (sensor $CV610_SENSOR, modules $CV610_MODULES, sensor profile $CV610_SENSOR_PROFILE, audio $CV610_AUDIO)"
 }
 
 stop()
diff --git a/src/cv610_modes.c b/src/cv610_modes.c
index 358a14b..03d4306 100644
--- a/src/cv610_modes.c
+++ b/src/cv610_modes.c
@@ -1,6 +1,9 @@
 #include "cv610_modes.h"
 
-/* All four entries are hardware-verified on the IMX662 bring-up board.
+#include <stdlib.h>
+#include <string.h>
+
+/* IMX662: all four entries are hardware-verified on the bring-up board.
  *
  * The clock column is the one that bites.  The sensor keeps whatever line
  * timing it was programmed with regardless of the MCLK it is actually fed,
@@ -9,15 +12,69 @@
  * Measured 43.6 fps for the 60 fps mode when it ran on the 100 fps mode's
  * 27 MHz clock.  Only 100 fps takes the sensor's 24 MHz INCK profile
  * overclocked to 27 MHz (INCK_SEL 0x04); the rest run 37.125 MHz. */
-static const Cv610SensorMode g_cv610_modes[] = {
+static const Cv610SensorMode g_imx662_modes[] = {
 	{ 1920, 1080,  30, 12, 37125000u, "1080p30 RAW12" },
 	{ 1920, 1080,  60, 12, 37125000u, "1080p60 RAW12" },
 	{ 1920, 1080,  90, 10, 37125000u, "1080p90 RAW10" },
 	{ 1920, 1080, 100, 10, 27000000u, "1080p100 RAW10" },
 };
 
-#define CV610_MODE_COUNT \
-	(sizeof(g_cv610_modes) / sizeof(g_cv610_modes[0]))
+/* IMX335 on a board that wires only two MIPI data lanes, to PHY lanes 0
+ * and 2 (Hi3516CV610-20S + IMX335, e.g. the H5SVX module).  The plugin's
+ * mode 0 must carry the 2-lane RAW10 register table (LANEMODE 0x3A01=1,
+ * INCK 24 MHz) taken from the module's stock firmware: the openhisilicon
+ * 12-bit table leaves the sensor at its 4-lane default, which on this wiring
+ * delivers half-width lines. */
+static const Cv610SensorMode g_imx335_2lane_modes[] = {
+	{ 2592, 1944,  30, 10, 24000000u, "5MP30 RAW10 2-lane" },
+};
+
+static const Cv610Sensor g_cv610_sensors[] = {
+	{ "imx662", "/usr/lib/sensors/libsns_imx662.so", "g_sns_imx662_obj",
+	  662, { 0, 1, 2, 3 }, 0, g_imx662_modes,
+	  sizeof(g_imx662_modes) / sizeof(g_imx662_modes[0]) },
+	{ "imx335", "/usr/lib/sensors/libsns_imx335.so", "g_sns_imx335_obj",
+	  335, { 0, 2, -1, -1 }, 0, g_imx335_2lane_modes,
+	  sizeof(g_imx335_2lane_modes) / sizeof(g_imx335_2lane_modes[0]) },
+};
+
+#define CV610_SENSOR_COUNT \
+	(sizeof(g_cv610_sensors) / sizeof(g_cv610_sensors[0]))
+
+const Cv610Sensor *cv610_sensor(void)
+{
+	static const Cv610Sensor *active;
+	const char *want;
+	size_t i;
+
+	if (active != NULL)
+		return active;
+	active = &g_cv610_sensors[0];
+	want = getenv("CV610_SENSOR");
+	if (want == NULL || *want == '\0')
+		return active;
+	for (i = 0; i < CV610_SENSOR_COUNT; ++i) {
+		if (strcmp(g_cv610_sensors[i].name, want) == 0) {
+			active = &g_cv610_sensors[i];
+			break;
+		}
+	}
+	return active;
+}
+
+int cv610_sensor_lane_count(const Cv610Sensor *sensor)
+{
+	int i, n = 0;
+
+	for (i = 0; i < 4; ++i) {
+		if (sensor->lane_id[i] >= 0)
+			++n;
+	}
+	return n;
+}
+
+#define g_cv610_modes    (cv610_sensor()->modes)
+#define CV610_MODE_COUNT (cv610_sensor()->mode_count)
 
 const Cv610SensorMode *cv610_mode_table(size_t *count)
 {
