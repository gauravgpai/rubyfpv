index d4dea27..6e50a69 100644
--- a/bmp/region.c
+++ b/bmp/region.c
@@ -211,6 +211,67 @@ static void hifb_close(void) {
 }
 #endif
 
+#ifdef __CV6XX__
+// Same scheme as the HiSilicon V4 path below: one ARGB1555 overlay attached to
+// VENC channel 0, in the SDK V5 names. VENC overlay alpha runs to 255 here, not 128.
+static const ot_mpp_chn cv6xx_venc = {OT_ID_VENC, 0, 0};
+
+static int cv6xx_create_region(int handle, int x, int y, int width, int height) {
+	ot_rgn_attr stRegion, stRegionCurrent;
+	ot_rgn_chn_attr stChnAttr, stChnAttrCurrent;
+
+	memset(&stRegion, 0, sizeof(stRegion));
+	stRegion.type = OT_RGN_OVERLAY;
+	stRegion.attr.overlay.pixel_format = PIXEL_FORMAT_1555;
+	stRegion.attr.overlay.bg_color = 0x7fff;
+	stRegion.attr.overlay.size.width = width;
+	stRegion.attr.overlay.size.height = height;
+	stRegion.attr.overlay.canvas_num = 2;
+
+	int s32Ret = ss_mpi_rgn_get_attr(handle, &stRegionCurrent);
+	if (!s32Ret && (stRegionCurrent.attr.overlay.size.width != width ||
+					   stRegionCurrent.attr.overlay.size.height != height)) {
+		fprintf(stderr, "[%s:%d] Region parameters are different, recreating ... \n", __func__,
+			__LINE__);
+		ss_mpi_rgn_detach_from_chn(handle, &cv6xx_venc);
+		ss_mpi_rgn_destroy(handle);
+		s32Ret = -1;
+	}
+	if (s32Ret) {
+		if (verbose)
+			fprintf(stderr, "[%s:%d]RGN_GetAttr failed with %#x , creating region %d...\n",
+				__func__, __LINE__, s32Ret, handle);
+		s32Ret = ss_mpi_rgn_create(handle, &stRegion);
+		if (s32Ret) {
+			fprintf(stderr, "[%s:%d]RGN_Create failed with %#x!\n", __func__, __LINE__, s32Ret);
+			return -1;
+		}
+	}
+
+	if (!ss_mpi_rgn_get_chn_display_attr(handle, &cv6xx_venc, &stChnAttrCurrent)) {
+		if (stChnAttrCurrent.attr.overlay_chn.point.x == x &&
+			stChnAttrCurrent.attr.overlay_chn.point.y == y)
+			return 0;
+		ss_mpi_rgn_detach_from_chn(handle, &cv6xx_venc);
+	}
+
+	memset(&stChnAttr, 0, sizeof(stChnAttr));
+	stChnAttr.is_show = TD_TRUE;
+	stChnAttr.type = OT_RGN_OVERLAY;
+	stChnAttr.attr.overlay_chn.point.x = x;
+	stChnAttr.attr.overlay_chn.point.y = y;
+	stChnAttr.attr.overlay_chn.bg_alpha = 0;
+	stChnAttr.attr.overlay_chn.fg_alpha = OT_RGN_OVERLAY_VENC_MAX_ALPHA;
+	stChnAttr.attr.overlay_chn.layer = 7;
+	stChnAttr.attr.overlay_chn.qp_info.enable = TD_FALSE;
+	stChnAttr.attr.overlay_chn.dst = OT_RGN_ATTACH_JPEG_MAIN;
+
+	s32Ret = ss_mpi_rgn_attach_to_chn(handle, &cv6xx_venc, &stChnAttr);
+	if (s32Ret)
+		fprintf(stderr, "[%s:%d]RGN_AttachToChn failed with %#x!\n", __func__, __LINE__, s32Ret);
+	return s32Ret;
+}
+#endif
 
 
 int InitRGN_SigmaStar(){
