-#if !defined(_x86) && !defined(__ROCKCHIP__) && !defined(__HI3536__)
+#ifdef __CV6XX__
+	return cv6xx_create_region(*handle, x, y, width, height);
+#endif
+#if !defined(_x86) && !defined(__ROCKCHIP__) && !defined(__HI3536__) && !defined(__CV6XX__)
 #ifdef __SIGMASTAR__
 	MI_RGN_ChnPort_t stChn;
 
@@ -568,6 +632,9 @@ int set_bitmap(int handle, BITMAP *bitmap) {
 #if !defined(_x86) && !defined(__ROCKCHIP__) && !defined(__HI3536__)
 #ifdef __SIGMASTAR__
 	s32Ret = MI_RGN_SetBitMap(DEV handle, (MI_RGN_Bitmap_t *)(bitmap));
+#elif defined(__CV6XX__)
+	ot_bmp stBitmap = {bitmap->enPixelFormat, bitmap->u32Width, bitmap->u32Height, bitmap->pData};
+	s32Ret = ss_mpi_rgn_set_bmp(handle, &stBitmap);
 #elif __GOKE__
 	s32Ret = HI_MPI_RGN_SetBitMap(handle, (BITMAP_S *)(bitmap));
 #endif
@@ -658,6 +725,12 @@ int unload_region(int *handle) {
 	if (s32Ret)
 		fprintf(stderr, "[%s:%d]RGN_Destroy failed with %#x %d!\n", __func__, __LINE__, s32Ret,
 			*handle);
+#elif defined(__CV6XX__)
+	ss_mpi_rgn_detach_from_chn(*handle, &cv6xx_venc);
+	s32Ret = ss_mpi_rgn_destroy(*handle);
+	if (s32Ret)
+		fprintf(stderr, "[%s:%d]RGN_Destroy failed with %#x %d!\n", __func__, __LINE__, s32Ret,
+			*handle);
 #elif __GOKE__
 	MPP_CHN_S stChn;
 	stChn.s32DevId = 0;
