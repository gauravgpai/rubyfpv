--- a/libraries/sensor/hi3516cv6xx/sony_imx335/imx335_cmos.h
+++ b/libraries/sensor/hi3516cv6xx/sony_imx335/imx335_cmos.h
@@ -115,15 +115,36 @@
 #define IMX335_FLEX_VMAX_BASE      (0x08F8)
 #define IMX335_FLEX_HMAX_MIN       64
 #define IMX335_FLEX_HMAX_MAX       8191
+/* Shortest usable line (HMAX) for a window of HNUM pixels on this board.
+ * Two limits, measured on the bench:
+ *  - the two MIPI lanes at 1188 Mbit/s must carry a RAW10 row of HNUM pixels
+ *    within 2H: HMAX >= FLEX_CLK * HNUM * 10 / (2 * lanes * rate), plus
+ *    packet overhead. At HNUM 1944 the bare figure is 304; 308 truncates
+ *    frames, 317 is clean, so 5% is allowed for the overhead;
+ *  - the sensor's own minimum line, 0x113 (the floor of the 4-lane 120/144
+ *    fps tables): 1536x864 at HMAX 269 has room on the link but comes out
+ *    streaked.
+ * 1080p therefore tops out at ~101 fps; 1536x864 reaches 120 at HMAX 332. */
+#define IMX335_MIPI_LANES          2
+#define IMX335_MIPI_MBPS           1188
+#define IMX335_ROW_MARGIN_PCT      105
+#define IMX335_HMAX_MIN_AD         275
+#define IMX335_HMAX_LANES(hnum) \
+    ((td_u32)(((td_u64)IMX335_FLEX_CLK * (hnum) * 10 * IMX335_ROW_MARGIN_PCT + \
+    (td_u64)2 * IMX335_MIPI_LANES * IMX335_MIPI_MBPS * 1000000 * 100 - 1) / \
+    ((td_u64)2 * IMX335_MIPI_LANES * IMX335_MIPI_MBPS * 1000000 * 100)))
+#define IMX335_HMAX_FLOOR(hnum) \
+    ((IMX335_HMAX_LANES(hnum) > IMX335_HMAX_MIN_AD) ? IMX335_HMAX_LANES(hnum) : IMX335_HMAX_MIN_AD)
 #define IMX335_CROP_W_DEFAULT      1920
 #define IMX335_CROP_H_DEFAULT      1080
 #define IMX335_FPS_MAX_FLEX        240
 #define IMX335_FPS_MIN_FLEX        2.0
 /* Flex VMAX for a crop height: the window's own frame length, which the T6 VI
- * requires to stay put. */
-#define IMX335_FLEX_VMAX(crop_h) \
-    (((((crop_h) + 20) * 2 + 96) > IMX335_FLEX_VMAX_BASE) ? \
-     (((crop_h) + 20) * 2 + 96) : IMX335_FLEX_VMAX_BASE)
+ * requires to stay put. It used to be held at or above the 1080p table's
+ * 0x08F8; on two lanes that left windows under 1080 lines no way to 120 fps
+ * (HMAX would have to go below the sensor minimum), so they now run at their
+ * own, shorter length (1536x864: 1864). */
+#define IMX335_FLEX_VMAX(crop_h) (((crop_h) + 20) * 2 + 96)
 /* Slowest rate the 13-bit HMAX can express at a given fixed VMAX. */
 #define IMX335_FLEX_MIN_FPS(vmax) \
     ((td_float)IMX335_FLEX_CLK / ((td_float)IMX335_FLEX_HMAX_MAX * (td_float)(vmax)))
--- a/libraries/sensor/hi3516cv6xx/sony_imx335/imx335_cmos.c
