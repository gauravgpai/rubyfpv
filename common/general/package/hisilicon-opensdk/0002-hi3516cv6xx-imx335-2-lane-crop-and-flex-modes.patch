+
+            if (sns_state->img_mode == IMX335_CROP_FLEX_LINEAR_MODE) {
+                imx335_get_crop(vi_pipe, &crop_w, TD_NULL);
+            }
+            if (hmax < IMX335_HMAX_FLOOR(crop_w + 24)) {
+                isp_err_trace("imx335 crop: fps %f needs HMAX %u < 2-lane floor %u\n",
+                    fps, hmax, IMX335_HMAX_FLOOR(crop_w + 24));
+                return;
+            }
+        }
         imx335_set_crop_hmax(vi_pipe, hmax);
         if (cis->i2c.fd >= 0) {
             imx335_config_hmax(cis, hmax);
@@ -1190,6 +1202,16 @@
                     sns_image_mode->fps, min_fps, crop_w, crop_h);
                 return TD_FAILURE;
             }
+            /* Nor one faster than the line-time floor allows at this width. */
+            if ((td_float)IMX335_FLEX_CLK / (sns_image_mode->fps * (td_float)vmax) <
+                (td_float)IMX335_HMAX_FLOOR(crop_w + 24)) {
+                isp_err_trace("imx335 flex: fps %f above the 2-lane limit %f for %ux%u\n",
+                    sns_image_mode->fps,
+                    (td_float)IMX335_FLEX_CLK /
+                    ((td_float)IMX335_HMAX_FLOOR(crop_w + 24) * (td_float)vmax),
+                    crop_w, crop_h);
+                return TD_FAILURE;
+            }
         }
         imx335_get_crop(vi_pipe, &old_w, &old_h);
         old_fps = imx335_get_flex_fps(vi_pipe);
